# Set your real domain only, without https:// or a path.
SALON_DOMAIN=salon.example.com

# Optional: automatic numeric Google rating (private .env only; never commit a real key).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Google customer sign-in: public OAuth 2.0 Web client ID, obtained from Google Cloud.
GOOGLE_CLIENT_ID=

# Booking confirmations. Set these privately on the hosting server.
# WhatsApp requires an approved template with four body variables:
# {{1}} service, {{2}} date/time, {{3}} Google Maps URL, {{4}} booking reference.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_VERSION=

# Email requires a verified sender domain in Resend.
RESEND_API_KEY=
BOOKING_EMAIL_FROM=
